# /etc/counter/env, root:counter 0640: every variable the service reads, one per line.
# The rc script refuses to start while one is empty or REPLACE_ME. The service
# listens on the jail address, port 4010; https://counter.example.org is its public URL.
COUNTER_DATABASE_PATH=/var/db/counter/counter.sqlite3
COUNTER_LISTEN_ADDRESS=10.20.0.3:4010
