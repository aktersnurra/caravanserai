# /etc/hello/env, root:hello 0640: replace every REPLACE_ME before the first activation.
PHX_SERVER=true
# The jail ip instead in a rehearsal jail.
PHX_HOST=hello.example.org
PORT=4000
DATABASE_PATH=/var/db/hello/hello.db
POOL_SIZE=5
# The BEAM needs a UTF-8 locale, and nothing in the jail sets one.
LANG=C.UTF-8
# mix phx.gen.secret
SECRET_KEY_BASE=REPLACE_ME
RELEASE_COOKIE=REPLACE_ME
RELEASE_TMP=/var/run/hello
