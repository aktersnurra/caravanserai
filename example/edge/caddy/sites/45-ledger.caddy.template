# ---------------------------------------------------------------------------
# ledger (OCaml, Linux bhyve guest)
# ---------------------------------------------------------------------------
__LEDGER_HOSTNAME__ {
    import access_log
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
    reverse_proxy __LEDGER_IP__:__LEDGER_HTTP_PORT__ {
        # Wait out a restart rather than answer 502.
        lb_try_duration 30s
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }
}
