; A pinned upstream binary.
(
(name idp)
(ip 10.20.0.5)
(hostname id.example.org)
(tailnet_ports ((http 1411)))
(operator_ports ())
(strategy fetch_binary)
(hooks (bootstrap check update-version))
(extra_steps ())
(strategy_config (
  (version v2.16.0)
  (binary_sha256 942e6ceff2a87f12011a776551758245889250ffa5039034f130347921d9940b)
  (binary_url_template https://downloads.example.org/idp/${VERSION}/idp_freebsd_amd64)
  (binary_name idp)
  (packages (sqlite3))
  (data_dir /var/db/idp)
  (port 1411)
  (env_values ((APP_URL https://id.example.org) (DB_PATH /var/db/idp/idp.db)))
  (generated_secrets (SESSION_KEY))
  (env_template_path env.template)
  (rc_template_path idp.rc.template)
  (check_path /)
))
)
